{
  "manifest_version": 3,
  "name": "FormFill",
  "version": "1.0.0",
  "description": "Auto-fill forms on sites you define by exact URL, prefix, or origin.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FormFill"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["match.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
